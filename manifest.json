{
  "manifest_version": 3,
  "name": "NetHelper",
  "version": "4.0.0",
  "description": "Quick access to NetSuite records by internal ID. Resolves custom record types by script ID across accounts.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/NetHelper-Icon-16x16.png",
      "32": "icons/NetHelper-Icon-32x32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.netsuite.com/*"
  ],
  "icons": {
    "16": "icons/NetHelper-Icon-16x16.png",
    "32": "icons/NetHelper-Icon-32x32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "NetHelper@moracode.com"
    }
  }
}
